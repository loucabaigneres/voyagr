# URL de l'API Voyagr.
# - Simulateur iOS / web : http://localhost:3000
# - Émulateur Android    : http://10.0.2.2:3000
#                          (ou `adb reverse tcp:3000 tcp:3000` puis http://localhost:3000, requis pour Google)
# - Téléphone physique   : http://<IP LAN de ta machine>:3000
#                          (Google refuse les IP privées : passe par un tunnel HTTPS, voir README)
EXPO_PUBLIC_API_URL=http://localhost:3000
