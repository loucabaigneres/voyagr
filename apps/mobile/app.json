{
  "expo": {
    "name": "Seego",
    "slug": "voyagr",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "voyagr",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.voyagr.app"
    },
    "android": {
      "package": "com.voyagr.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F0E8"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F0E8"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
